# Copy to .env.local and fill in values for contact/newsletter email delivery.
# Leave RESEND_API_KEY empty to log submissions in development only.
# Never put real secrets in this file — it is committed to git.

RESEND_API_KEY=
CONTACT_TO_EMAIL=info@13utopia.com
CONTACT_FROM_EMAIL=noreply@13utopia.com
NEXT_PUBLIC_SITE_URL=https://13utopia.com
